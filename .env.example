# Copy this file to .env and fill it in. Never commit .env.

PORT=3000

# Demo mode simulates checkout and does not charge a payment method.
PAYMENT_MODE=mock

# Use the pooled URL for web requests and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Required when PAYMENT_MODE=razorpay. Keep the secret values server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Long random string. Used to open /admin.html and the admin API.
ADMIN_TOKEN=change_me_to_a_long_random_string

# Registration window (ISO times, India time). Requests outside it are refused.
REG_OPEN=2026-11-01T00:00:00+05:30
REG_CLOSE=2026-12-20T23:59:59+05:30

# Leave empty when the site and API are deployed together.
ALLOWED_ORIGIN=
