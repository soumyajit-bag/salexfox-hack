# Copy this file to .env and fill it in. Never commit .env.

PORT=3000

# "razorpay" takes real payments. "mock" fakes payment so you can test the whole flow without keys.
PAYMENT_MODE=razorpay

# Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Dashboard > Webhooks. Use the same secret you type there.
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# Long random string. Used to open /admin.html and the admin API.
ADMIN_TOKEN=change_me_to_a_long_random_string

# Where the SQLite file lives. On a host with a disk, point this at the mounted disk.
DB_PATH=./data/registrations.db

# Registration window (ISO times, India time). Requests outside it are refused.
REG_OPEN=2026-11-01T00:00:00+05:30
REG_CLOSE=2026-12-20T23:59:59+05:30

# Your site address, used for CORS if the frontend is hosted elsewhere. Leave empty if the
# frontend is served by this same server.
ALLOWED_ORIGIN=
